@{
    ViewBag.Title = "About Us";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="hero-section text-white mb-5 shadow-lg position-relative overflow-hidden" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); padding: 100px 0; margin: -20px -15px 50px; border-radius: 0 0 40px 40px;">
    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: radial-gradient(circle at top left, rgba(245, 158, 11, 0.15), transparent 50%); pointer-events: none;"></div>
    <div class="container text-center position-relative z-index-1">
        <h1 class="display-4 fw-bold mb-3" style="text-shadow: 0 4px 15px rgba(0,0,0,0.3);">Our <span style="background: linear-gradient(90deg, #f59e0b, #ed8936); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Story</span></h1>
        <p class="lead text-light opacity-75 fw-normal">Connecting you with the true taste of Ethiopia.</p>
    </div>
</div>

<div class="container mb-5 pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg p-5 mb-5 rounded-4 auth-card" style="background: linear-gradient(to right bottom, #ffffff, #f8fafc);">
                <div class="pe-md-4">
                    <h3 class="fw-bold mb-4 text-dark border-bottom pb-3 border-2 border-warning d-inline-block">Who We Are</h3>
                    <p class="lead text-dark font-weight-normal" style="line-height: 1.8;">
                        Habesha Kitchen is a premium destination for authentic Ethiopian cuisine, offering a refined dining experience rooted in tradition. We prepare each dish using fresh, high-quality ingredients and expertly blended spices to deliver the rich, distinctive flavors of Ethiopia. From injera paired with slow-cooked wot stews to expertly grilled meats and wholesome vegetarian selections, every plate reflects the depth of Ethiopian culinary heritage.
                    </p>
                    <p class="text-muted" style="line-height: 1.8;">
                        At Habesha Kitchen, we are committed to preserving cultural authenticity while providing warm, professional service in a welcoming atmosphere that captures the true essence of Ethiopian hospitality.
                    </p>
                </div>
            </div>
            
            <div class="row g-4 mt-2">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm p-4 h-100 rounded-4 text-center auth-card transition-all">
                        <div class="rounded-circle d-inline-flex mx-auto align-items-center justify-content-center mb-3 shadow-sm bg-light text-warning" style="width:70px;height:70px;font-size:2rem;">
                            <i class="bi bi-shop"></i>
                        </div>
                        <h4 class="fw-bold mb-1">Premium</h4>
                        <p class="small text-muted mb-0">Restaurants</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm p-4 h-100 rounded-4 text-center auth-card transition-all">
                        <div class="rounded-circle d-inline-flex mx-auto align-items-center justify-content-center mb-3 shadow-sm bg-light text-warning" style="width:70px;height:70px;font-size:2rem;">
                            <i class="bi bi-lightning-charge"></i>
                        </div>
                        <h4 class="fw-bold mb-1">Lightning</h4>
                        <p class="small text-muted mb-0">Fast Delivery</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm p-4 h-100 rounded-4 text-center auth-card transition-all">
                        <div class="rounded-circle d-inline-flex mx-auto align-items-center justify-content-center mb-3 shadow-sm bg-light text-warning" style="width:70px;height:70px;font-size:2rem;">
                            <i class="bi bi-headset"></i>
                        </div>
                        <h4 class="fw-bold mb-1">24/7</h4>
                        <p class="small text-muted mb-0">Customer Support</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
