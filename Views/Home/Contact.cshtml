@model FoodDelivery.Models.ViewModels.ContactViewModel
@{
    ViewBag.Title = "Contact Us";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="hero-section text-white mb-5 shadow-lg position-relative overflow-hidden" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); padding: 100px 0; margin: -20px -15px 50px; border-radius: 0 0 40px 40px;">
    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: radial-gradient(circle at bottom center, rgba(237, 137, 54, 0.15), transparent 60%); pointer-events: none;"></div>
    <div class="container text-center position-relative z-index-1">
        <h1 class="display-4 fw-bold mb-3" style="text-shadow: 0 4px 15px rgba(0,0,0,0.3);">Get In <span style="background: linear-gradient(90deg, #ed8936, #f56565); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Touch</span></h1>
        <p class="lead text-light opacity-75 fw-normal">We'd love to hear from you. Drop us a line below.</p>
    </div>
</div>

<div class="container mb-5 pb-5">
    <div class="row justify-content-center g-5">
        <div class="col-lg-4">
            <h3 class="fw-bold mb-4 text-dark border-bottom pb-3 border-2 border-warning d-inline-block">Contact Info</h3>
            <div class="card border-0 shadow-lg p-4 mb-4 rounded-4 auth-card" style="background: linear-gradient(to right bottom, #ffffff, #f8fafc);">
                <div class="mb-2">
                    <div class="d-flex align-items-center mb-4">
                        <div class="rounded-circle bg-light text-warning d-flex align-items-center justify-content-center shadow-sm me-3" style="width: 50px; height: 50px; font-size: 1.5rem;">
                            <i class="bi bi-envelope-fill"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold">Email Us</h6>
                            <a href="mailto:support@fooddelivery.com" class="text-muted text-decoration-none small">support@fooddelivery.com</a>
                        </div>
                    </div>
                    
                    <div class="d-flex align-items-center mb-4">
                        <div class="rounded-circle bg-light text-warning d-flex align-items-center justify-content-center shadow-sm me-3" style="width: 50px; height: 50px; font-size: 1.5rem;">
                            <i class="bi bi-telephone-fill"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold">Call Us</h6>
                            <span class="text-muted small">+1 (800) 123-4567</span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-light text-warning d-flex align-items-center justify-content-center shadow-sm me-3" style="width: 50px; height: 50px; font-size: 1.5rem;">
                            <i class="bi bi-geo-alt-fill"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold">Visit Us</h6>
                            <span class="text-muted small">123 Food Street, District 9</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-lg p-4 p-md-5 rounded-4 auth-card" style="background: #ffffff;">
                <h4 class="fw-bold mb-4">Send a Message</h4>
                @using (Html.BeginForm("Contact", "Home", FormMethod.Post, new { role = "form" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="form-floating mb-3">
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control bg-light border-0", id = "nameInput", placeholder = "Your name" })
                        <label for="nameInput" class="text-muted">Your Name</label>
                        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger small" })
                    </div>
                    <div class="form-floating mb-3">
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control bg-light border-0", id = "emailInput", placeholder = "name@example.com", type = "email" })
                        <label for="emailInput" class="text-muted">Email Address</label>
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                    </div>
                    <div class="form-floating mb-4">
                        @Html.TextAreaFor(m => m.Message, new { @class = "form-control bg-light border-0", id = "messageInput", placeholder = "Your message...", style = "height: 150px" })
                        <label for="messageInput" class="text-muted">How can we help you?</label>
                        @Html.ValidationMessageFor(m => m.Message, "", new { @class = "text-danger small" })
                    </div>
                    <button type="submit" class="btn btn-warning btn-lg w-100 rounded-pill fw-bold shadow-sm btn-auth text-white" style="background: linear-gradient(135deg, #f59e0b 0%, #ed8936 100%); border: none;">
                        Send Message <i class="bi bi-send ms-2"></i>
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
