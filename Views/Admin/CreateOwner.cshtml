@model FoodDelivery.Models.ViewModels.CreateOwnerViewModel
@{
    ViewBag.Title = "Create Restaurant Owner";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mb-5 pb-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Create Restaurant Owner</h2>
        <a href="@Url.Action("Users", "Admin")" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i> Back to Users
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-body p-4 p-md-5">
                    @using (Html.BeginForm("CreateOwner", "Admin", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger small py-2 border-0 rounded-3 mb-4" })

                        <div class="form-floating mb-4 position-relative">
                            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control bg-light border-0", placeholder = "Full Name" })
                            @Html.LabelFor(m => m.FullName, new { @class = "text-muted" })
                            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small position-absolute top-100 start-0 pt-0" })
                        </div>

                        <div class="form-floating mb-4 position-relative">
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control bg-light border-0", placeholder = "name@example.com" })
                            @Html.LabelFor(m => m.Email, new { @class = "text-muted" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small position-absolute top-100 start-0 pt-0" })
                        </div>

                        <div class="form-floating mb-4 position-relative">
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control bg-light border-0", placeholder = "Password" })
                            @Html.LabelFor(m => m.Password, new { @class = "text-muted" })
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small position-absolute top-100 start-0 pt-0" })
                        </div>

                        <div class="form-floating mb-5 position-relative">
                            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control bg-light border-0", placeholder = "Confirm Password" })
                            @Html.LabelFor(m => m.ConfirmPassword, new { @class = "text-muted" })
                            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small position-absolute top-100 start-0 pt-0" })
                        </div>

                        <div class="d-grid mb-2">
                            <button type="submit" class="btn btn-warning btn-lg rounded-pill fw-bold shadow-sm text-white" style="background: linear-gradient(135deg, #f59e0b 0%, #ed8936 100%); border: none;">
                                Create Owner <i class="bi bi-person-plus ms-1"></i>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
