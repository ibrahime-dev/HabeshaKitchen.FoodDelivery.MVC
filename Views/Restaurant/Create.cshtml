@model FoodDelivery.Models.ViewModels.RestaurantCreateEditViewModel
@{
    ViewBag.Title = "Create Restaurant";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header"><h4 class="mb-0">Create Your Restaurant</h4></div>
            <div class="card-body">
                @using (Html.BeginForm("Create", "Restaurant", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Name, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Restaurant name" })
                        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                    </div>
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Description, new { @class = "form-label fw-bold" })
                        @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 3, placeholder = "Short description" })
                        @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                    </div>
                    <div class="mb-3">
                        @Html.LabelFor(m => m.CuisineCategory, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.CuisineCategory, new { @class = "form-control", placeholder = "e.g. Ethiopian" })
                        @Html.ValidationMessageFor(m => m.CuisineCategory, "", new { @class = "text-danger" })
                    </div>
                    <div class="mb-3">
                        @Html.LabelFor(m => m.PhoneNumber, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "e.g. 0911234567" })
                        @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger" })
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success">Create Restaurant</button>
                        @Html.ActionLink("Cancel", "Dashboard", null, new { @class = "btn btn-outline-secondary" })
                    </div>
                }
            </div>
        </div>
    </div>
</div>
