@model FoodDelivery.Models.ViewModels.CartViewModel
@{
    ViewBag.Title = "My Cart";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-12">
        <h2>My Cart</h2>
        @if (TempData["CrossRestaurantWarning"] != null)
        {
            var newItemId = TempData["CrossRestaurantWarning"];
            var newRestaurantName = TempData["CrossRestaurantName"];
            <div class="alert alert-warning">
                <strong>Different Restaurant!</strong> Your cart contains items from <strong>@Model.RestaurantName</strong>.
                Adding this item from <strong>@newRestaurantName</strong> will clear your current cart.
                @using (Html.BeginForm("AddItem", "Cart", FormMethod.Post, new { style = "display:inline;" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="menuItemId" value="@newItemId" />
                    <input type="hidden" name="confirmClear" value="true" />
                    <button type="submit" class="btn btn-warning btn-sm">Yes, clear cart and add item</button>
                }
                @Html.ActionLink("No, keep my cart", "Index", null, new { @class = "btn btn-default btn-sm" })
            </div>
        }
    </div>
</div>

@if (Model.IsEmpty)
{
    <div class="row">
        <div class="col-md-12">
            <div class="alert alert-info">Your cart is empty. @Html.ActionLink("Browse menu", "Index", "Home")</div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <button class="btn btn-primary" disabled>Proceed to Checkout</button>
        </div>
    </div>
}
else
{
    <div class="row">
        <div class="col-md-12">
            <p><strong>Restaurant:</strong> @Model.RestaurantName</p>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Subtotal</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.MenuItemName</td>
                            <td class="unit-price" data-price="@item.UnitPrice">@item.UnitPrice.ToString("F2") ETB</td>
                            <td>
                                @using (Html.BeginForm("UpdateQuantity", "Cart", FormMethod.Post, new { style = "display:inline;" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                    <input type="number" name="quantity" value="@item.Quantity" min="0" max="99" style="width:60px;" class="form-control input-sm qty-input" />
                                    <button type="submit" class="btn btn-default btn-xs">Update</button>
                                }
                            </td>
                            <td class="subtotal-cell">@item.Subtotal.ToString("F2") ETB</td>
                            <td>
                                @using (Html.BeginForm("RemoveItem", "Cart", FormMethod.Post, new { style = "display:inline;" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                    <button type="submit" class="btn btn-danger btn-xs">Remove</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3"><strong>Total</strong></td>
                        <td><strong><span id="cart-total">@Model.Total.ToString("F2")</span> ETB</strong></td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>

            <div class="row">
                <div class="col-md-12">
                    @using (Html.BeginForm("Clear", "Cart", FormMethod.Post, new { style = "display:inline;" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-default" onclick="return confirm('Clear your cart?')">Clear Cart</button>
                    }
                    @Html.ActionLink("Proceed to Checkout", "Checkout", "Order", null, new { @class = "btn btn-primary", style = "margin-left:10px;" })
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
    document.querySelectorAll('.qty-input').forEach(function (input) {
        input.addEventListener('input', function () {
            var row = this.closest('tr');
            var price = parseFloat(row.querySelector('.unit-price').dataset.price);
            var qty = parseInt(this.value) || 0;
            var subtotal = price * qty;
            row.querySelector('.subtotal-cell').textContent = subtotal.toFixed(2) + ' ETB';

            // Recalculate total
            var total = 0;
            document.querySelectorAll('.subtotal-cell').forEach(function (cell) {
                total += parseFloat(cell.textContent) || 0;
            });
            document.getElementById('cart-total').textContent = total.toFixed(2);
        });
    });
</script>
}
